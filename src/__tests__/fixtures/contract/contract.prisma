namespace public {
  native_enum ROLE {
    USER
    ADMIN
  }

  model User {
    id          Uuid        @id @default(dbgenerated("gen_random_uuid()"))
    /// @customType(Schema.String.pipe(Schema.brand('DisplayName')))
    displayName String      @map("display_name")
    amount      BigInt
    metadata    Jsonb?
    role        pg.enum(ROLE)
    createdAt   Timestamptz @default(now()) @map("created_at")
    products    Product[]

    @@map("user")
  }

  model Product {
    id      Uuid @id @default(dbgenerated("gen_random_uuid()"))
    ownerId Uuid @map("owner_id")
    owner   User @relation(fields: [ownerId], references: [id])

    @@map("product")
  }

  model UserProducts {
    a       Uuid    @map("A")
    b       Uuid    @map("B")
    product Product @relation(fields: [a], references: [id])
    user    User    @relation(fields: [b], references: [id])

    @@id([a, b])
    @@map("_user_products")
  }
}
