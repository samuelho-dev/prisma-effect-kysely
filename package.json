{
  "name": "prisma-effect-kysely",
  "version": "8.0.0",
  "description": "Generate Effect Schema codecs and Kysely types from Prisma 8 contracts",
  "license": "MIT",
  "author": "Samuel Ho",
  "bin": {
    "prisma-effect-kysely": "dist/cli.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "keywords": [
    "prisma",
    "generator",
    "effect",
    "schema",
    "typescript",
    "type-safety",
    "prisma-generator",
    "effect-ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelho-dev/prisma-effect-kysely.git"
  },
  "bugs": {
    "url": "https://github.com/samuelho-dev/prisma-effect-kysely/issues"
  },
  "homepage": "https://github.com/samuelho-dev/prisma-effect-kysely#readme",
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.3.13"
  },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build": "./node_modules/@typescript/native/bin/tsc -p tsconfig.lib.json",
    "contract:fixture": "prisma contract emit --config src/__tests__/fixtures/contract/prisma.config.ts",
    "prepare": "husky",
    "test": "bun run contract:fixture && vitest run",
    "test:watch": "bun run contract:fixture && vitest",
    "test:coverage": "bun run contract:fixture && vitest run --coverage",
    "typecheck": "./node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.lib.json && ./node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.spec.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "bun run build && changeset publish",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "prettier": "^3.9.8"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.117",
    "kysely": "^0.29.6"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@prisma/generator-helper": "^7.10.0",
    "@prisma/internals": "^7.10.0",
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "effect": "4.0.0-rc.117",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "kysely": "^0.29.6",
    "lint-staged": "^17.5.1",
    "prisma": "8.0.0-rc.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
